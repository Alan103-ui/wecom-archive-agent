# ============================================================
# wecom-archive-agent 私有化部署配置模板
# 复制为 .env 后按客户环境填写：cp .env.example .env
# ============================================================

# ---- 应用 ----
PORT=8002
DEBUG=false

# ---- 安全（生产必改！生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"）----
AUTH_SECRET_KEY=please-change-to-random-48-chars

# ---- 授权 License（私有化年费核心）----
# true=强制校验（无有效许可证将受限运行）；开发/演示用 false
LICENSE_REQUIRED=true

# ---- 数据库：默认 SQLite（data/archive.db），生产建议 PostgreSQL ----
# DATABASE_URL=sqlite:////app/data/archive.db
# DATABASE_URL=postgresql+psycopg://user:pwd@host:5432/wecom_archive

# ---- 采集模式：mock=演示数据 / archive=企业微信会话存档 ----
COLLECTOR_MODE=archive

# ---- 企业微信会话存档凭证（archive 模式必填）----
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_CUSTOMER_CONTACT_SECRET=
# Linux 镜像内 SDK 路径
WECOM_SDK_PATH=/app/data/sdk/libWeWorkFinanceSdk_C.so
WECOM_PRIVATE_KEY_PATH=/app/data/sdk/private_key.pem

# ---- OCR ----
OCR_ENABLED=true
# 视觉升级（智谱 GLM-4.6V-Flash 等，可选）
OCR_VISION_ENABLED=false

# ---- LLM 结构化抽取（默认本地 Ollama；也可配外部兼容接口）----
EXTRACT_ENABLED=true
OLLAMA_BASE_URL=http://172.17.6.18:11434
OLLAMA_MODEL=qwen2.5:14b

# ---- 预警投递（按需配置）----
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=AI数据助手 <xxx@yourdomain.com>
