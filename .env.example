# ============================================================
# 企业微信会话存档智能体 — 配置样例
# 复制本文件为 .env 后按需修改。所有项均有默认值，最小可仅改 DATABASE_URL。
# ============================================================

# ---------------- 数据库 ----------------
# SQLite:     sqlite:///D:/Clow/projects/wecom-archive-agent/data/archive.db
# PostgreSQL: postgresql+psycopg://user:pwd@host:5432/wecom_archive
DATABASE_URL=sqlite:///D:/Clow/projects/wecom-archive-agent/data/archive.db

# ---------------- 采集模式 ----------------
# mock   = 内置模拟数据（开箱演示，无需企业微信）
# archive = 真实企业微信会话内容存档（需配置下方 WECOM_* 与官方 SDK）
COLLECTOR_MODE=mock

# ---------------- 企业微信会话存档（真实模式才需要） ----------------
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
# SDK 动态库：Windows 用 WeWorkFinanceSdk.dll ；Linux 用 libWeWorkFinanceSdk_C.so
WECOM_SDK_PATH=D:/Clow/projects/wecom-archive-agent/data/sdk/WeWorkFinanceSdk.dll
# 企业自持 RSA 私钥 PEM，用于解密 encrypt_random_key
WECOM_PRIVATE_KEY_PATH=D:/Clow/projects/wecom-archive-agent/data/sdk/private_key.pem
# 多版本公钥场景：{"1":"/path/key_v1.pem","2":"/path/key_v2.pem"}
WECOM_PRIVATE_KEY_MAP=
WECOM_PROXY=
WECOM_PROXY_PASSWD=
WECOM_SDK_TIMEOUT=30
WECOM_FETCH_LIMIT=500

# ---------------- 采集过滤 ----------------
# 只采集指定群（roomid，逗号分隔），留空=全部
FILTER_ROOM_IDS=
# 本项目以群聊为主，默认跳过单聊
ONLY_GROUP_CHAT=True

# ---------------- 媒体 / OCR / LLM ----------------
MEDIA_ROOT=D:/Clow/projects/wecom-archive-agent/data/media
MEDIA_MAX_SIZE_MB=100
MEDIA_DOWNLOAD_TYPES=image,file,emotion
OCR_ENABLED=True
OCR_PDF_DPI=200
OCR_PDF_MAX_PAGES=20
EXTRACT_ENABLED=True
# 以下 OLLAMA_* 仅在「首次启动且库内还没有任何模型连接」时，用于自动播种一条
# 「本地 Ollama」默认连接（同时服务于 结构化抽取 extract 与 风险研判 risk）。
# 之后模型连接完全由数据库驱动，可在「模型配置」页面增删改/测试/切换，无需改 .env。
OLLAMA_BASE_URL=http://172.17.6.18:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.1

# ---------------- 调度 ----------------
SCHEDULER_ENABLED=True
SYNC_INTERVAL_SECONDS=60
PIPELINE_INTERVAL_SECONDS=30
PIPELINE_BATCH_SIZE=20

# ============================================================
# 风险研判与分级预警子系统
# ============================================================
# 总开关
RISK_ENABLED=True
# 双引擎：关键词规则 + LLM 语义兜底。关掉 LLM 仅用关键词（省 token）
RISK_LLM_ENABLED=True
# 为省成本，仅当关键词未命中时才调 LLM（True=省，False=每条都跑 LLM）
RISK_LLM_ONLY_WHEN_KEYWORD_MISS=False
# 风险扫描作业间隔（秒），独立于同步/流水线
RISK_SCAN_INTERVAL_SECONDS=45
# 单轮风险扫描最多处理多少条未扫消息
RISK_SCAN_BATCH=50

# 企微应用消息推送（精准推具体人/部门，与群机器人 Webhook 互补）
# 管理后台 → 应用管理 → 自建应用 获取 agentid / secret
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=

# 邮件告警（SMTP 全局配置；具体收件人在「风控配置 → 管理层投递目标」里按层配）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=True
